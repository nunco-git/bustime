rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 계정(이메일 로그인) 한 개의 안내 설정: 그 계정으로 로그인한 사람만 읽고 고칠 수 있습니다.
    // 같은 계정으로 여러 기기에서 동시에 로그인해도 같은 문서를 함께 씁니다.
    match /accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['buses', 'min', 'on', 'vib', 'rep', 'gap', 'hear', 'scale', 'stop', 'favStops', 'favCities', 'updatedAt'])
        && (!('buses' in request.resource.data) || (request.resource.data.buses is string && request.resource.data.buses.size() <= 100))
        && (!('min' in request.resource.data) || (request.resource.data.min is number && request.resource.data.min >= 1 && request.resource.data.min <= 60))
        && (!('on' in request.resource.data) || request.resource.data.on is bool)
        && (!('vib' in request.resource.data) || request.resource.data.vib is bool)
        && (!('rep' in request.resource.data) || (request.resource.data.rep is number && request.resource.data.rep >= 1 && request.resource.data.rep <= 20))
        && (!('gap' in request.resource.data) || (request.resource.data.gap is number && request.resource.data.gap >= 10 && request.resource.data.gap <= 600))
        && (!('favStops' in request.resource.data) || (request.resource.data.favStops is list && request.resource.data.favStops.size() <= 50))
        && (!('favCities' in request.resource.data) || (request.resource.data.favCities is list && request.resource.data.favCities.size() <= 3))
        && (!('hear' in request.resource.data) || request.resource.data.hear is bool)
        && (!('scale' in request.resource.data) || (request.resource.data.scale is number && request.resource.data.scale >= 0.5 && request.resource.data.scale <= 3))
        && (!('stop' in request.resource.data) || request.resource.data.stop == null || request.resource.data.stop is map);
      allow delete: if false;
    }
  }
}
